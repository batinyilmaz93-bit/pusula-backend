// prisma/schema.prisma
// Production target for the SQLite dev backend in src/db.js. Structurally
// identical tables — moving to this is a data-layer swap, not a redesign.
// Setup: `npm i -D prisma && npm i @prisma/client`, point DATABASE_URL at a
// managed Postgres instance (Neon/Supabase both have a generous free tier),
// then `npx prisma migrate deploy`.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String       @id @default(uuid())
  name      String
  createdAt DateTime     @default(now()) @map("created_at")
  members   TripMember[]

  @@map("users")
}

model Trip {
  id             String       @id @default(uuid())
  name           String
  country        String
  city           String
  currencyCode   String?      @map("currency_code")
  adminMemberId  String       @map("admin_member_id")
  inviteCode     String       @unique @map("invite_code")
  createdAt      DateTime     @default(now()) @map("created_at")
  members        TripMember[]
  expenses       Expense[]
  hazards        Hazard[]

  @@map("trips")
}

model TripMember {
  id        String   @id @default(uuid())
  tripId    String   @map("trip_id")
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tripId])
  @@map("trip_members")
}

model Expense {
  id           String   @id @default(uuid())
  tripId       String   @map("trip_id")
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  description  String
  amount       Float
  category     String   @default("diger")
  paidBy       String   @map("paid_by")
  splitAmong   Json     @map("split_among")
  isSettlement Boolean  @default(false) @map("is_settlement")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tripId])
  @@map("expenses")
}

model Hazard {
  id        String   @id @default(uuid())
  tripId    String   @map("trip_id")
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  text      String
  addedBy   String?  @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tripId])
  @@map("hazards")
}
